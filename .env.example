# Copia a .env solo para desarrollo local. Nunca publiques .env.
POSTGRES_USER=hiqnet
POSTGRES_PASSWORD=hiqnet_dev
POSTGRES_DB=hiqnet
POSTGRES_PORT=5432
API_PORT=8080
RUST_LOG=info

# Token administrativo para mutaciones. Déjalo vacío para deshabilitar writes.
HIQNET_PLATFORM_ADMIN_TOKEN=dev-admin-token-change-me

# Clave de firma Ed25519 en base64 (32 bytes). Solo para desarrollo.
# Genera una con: cargo run -p platform-licensing --example gen-key (pendiente)
HIQNET_PLATFORM_SIGNING_KEY_B64=

# Habilita la emisión de licencias de desarrollo. Requiere clave de firma.
HIQNET_PLATFORM_ALLOW_DEV_ISSUANCE=false
DATABASE_URL=postgres://hiqnet:hiqnet_dev@localhost:5432/hiqnet
