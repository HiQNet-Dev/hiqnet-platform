# Copia a .env solo para desarrollo local. Nunca publiques .env.
POSTGRES_USER=hiqnet
POSTGRES_PASSWORD=replace-with-random-dev-password
POSTGRES_DB=hiqnet
POSTGRES_PORT=5432
API_PORT=8080
RUST_LOG=info

# Token administrativo para mutaciones. Déjalo vacío para deshabilitar writes.
HIQNET_PLATFORM_ADMIN_TOKEN=

# Clave de firma Ed25519 en base64 (32 bytes). Solo para desarrollo.
# Genera una con: cargo run -p platform-licensing --example gen-key (pendiente)
HIQNET_PLATFORM_SIGNING_KEY_B64=

# Habilita la emisión de licencias de desarrollo. Requiere clave de firma.
HIQNET_PLATFORM_ALLOW_DEV_ISSUANCE=false
# Sólo entorno DEV: sin esta opción, /docs y /api-docs/openapi.json no se sirven.
HIQNET_PLATFORM_ENABLE_DOCS=true
# Entorno y cookies. Secure=true es el valor por defecto; false sólo en development.
HIQNET_PLATFORM_ENV=development
HIQNET_PLATFORM_COOKIE_SECURE=false
HIQNET_PLATFORM_ALLOWED_ORIGIN=http://127.0.0.1:8080
HIQNET_PLATFORM_SESSION_TTL_HOURS=8
# Verificaciones Argon2id simultáneas por instancia (1–32).
HIQNET_PLATFORM_AUTH_CONCURRENCY=4
# Bootstrap local de cuentas sintéticas; nunca en producción.
HIQNET_PLATFORM_DEV_BOOTSTRAP=false
# Para cargo run local, usa la misma contraseña y puerto que POSTGRES_PASSWORD/POSTGRES_PORT.
DATABASE_URL=postgres://hiqnet:replace-with-random-dev-password@localhost:5432/hiqnet
